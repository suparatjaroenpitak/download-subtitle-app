{
  "expo": {
    "name": "Universal Transcriber",
    "slug": "universal-transcriber",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "universaltranscriber",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "bundleIdentifier": "com.universaltranscriber.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSDocumentPickerUsage": "เลือกไฟล์เสียงเพื่อถอดข้อความ"
      }
    },
    "android": {
      "package": "com.universaltranscriber.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": []
    },
    "plugins": [],
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
