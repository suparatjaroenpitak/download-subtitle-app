# ================= Universal Transcriber =================
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงเครื่อง/เซิร์ฟเวอร์ของคุณ

# ---- Runtime environment ----
# development | production
APP_ENV=development

# ---- Backend (FastAPI) ----
API_HOST=0.0.0.0
API_PORT=8000
# รายการ origin ที่อนุญาต CORS คั่นด้วย comma (production ห้ามใช้ *)
ALLOWED_ORIGINS=http://localhost:3000
# จำกัดขนาดไฟล์อัปโหลด (MB)
MAX_UPLOAD_MB=200
# จำกัดความยาวเสียง (นาที)
MAX_AUDIO_MINUTES=120
# อายุงาน + ไฟล์บนเซิร์ฟเวอร์ (ชั่วโมง) — หมดอายุแล้วลบอัตโนมัติ
JOB_TTL_HOURS=24
# อายุ job token (ชั่วโมง)
JOB_TOKEN_TTL_HOURS=24
# Rate limit ต่อ IP (ร้องเรียก upload ได้กี่ครั้ง/นาที)
RATE_LIMIT_UPLOAD_PER_MIN=5
RATE_LIMIT_YOUTUBE_PER_MIN=10
# โฟลเดอร์เก็บไฟล์และผลลัพธ์ (นับจาก root ของ apps/api)
DATA_DIR=./data

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Whisper ----
# ตัวเลือก: tiny | base | small | medium | large-v3
# CPU 4GB+ แนะนำ small, GPU 6GB+ ใช้ medium/large-v3 (ดู docs/deployment.md)
WHISPER_MODEL=small
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | th | en | (ภาษาอื่นตาม ISO-639-1)
WHISPER_DEFAULT_LANGUAGE=auto
# จำนวน worker process (ปล่อย 1 สำหรับ CPU เดียว)
WORKER_CONCURRENCY=1

# ---- Web (Next.js) ----
# URL ของ API ที่เบราว์เซอร์ผู้ใช้เรียกถึง ต้องเป็น absolute URL
# production ต้องเป็น HTTPS เช่น https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Mobile (Expo) ----
# ห้ามใช้ localhost บนเครื่องมือถือจริง — ใช้ LAN IP ของ dev หรือโดเมน production
# ตั้งใน apps/mobile/.env ด้วยแพ็กเกจ expo-constants (ดู apps/mobile/config.ts)
MOBILE_API_URL=http://192.168.1.100:8000
